!bingx_rl_trading_bot/data/features/*_raw_*.csv

# Legacy cleanup
bingx_rl_trading_bot/models/*.pkl
bingx_rl_trading_bot/data/trained_models/**/*.pkl
*.bat

# Environment
.env
.env.local
.env.production

# Python
__pycache__/
*.pyc
.venv/

# Logs
*.log
bingx_rl_trading_bot/logs/

# IDE
.vscode/
.idea/

# Runtime files
*.lock
*_state.json.backup_*
*_state.json.bak
*.local_backup
bingx_rl_trading_bot/results/pattern_5m_bot_state.json

# Large data files
bingx_rl_trading_bot/data/*.csv

# Runtime metrics (generated)
bingx_rl_trading_bot/results/pattern_5m_metrics.json
bingx_rl_trading_bot/results/pattern_5m_confidence_log.csv

# Analysis artifacts (one-time research)
bingx_rl_trading_bot/results/portfolio_*.json
bingx_rl_trading_bot/results/deep_*.json
bingx_rl_trading_bot/results/*_validation.json
bingx_rl_trading_bot/results/*_FAILURE*.txt
bingx_rl_trading_bot/results/*_study.json

# Archive (legacy data, moved during cleanup)
bingx_rl_trading_bot/archive/

# Cache
.pytest_cache/
bingx_rl_trading_bot/data/cache/

# bkit temp files
docs/.bkit-memory.json
docs/.pdca-*
